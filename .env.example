# This file serves as an example for the required environment variables.
# Copy this file to .env for local development and fill in the values.

# PostgreSQL Credentials
POSTGRES_USER=chimera
POSTGRES_PASSWORD=chimera
POSTGRES_DB=chimera
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME=chimera
MONGO_INITDB_ROOT_PASSWORD=chimera
MONGO_HOST=mongo
MONGO_PORT=27017

# Kafka Configuration
KAFKA_BROKERS=kafka:9092

# API Gateway Port
API_GATEWAY_PORT=8080

# Add other service-specific environment variables here as they are developed.
